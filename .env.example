# ---- 数据库(阿里云 RDS MySQL)----
DATABASE_URL=mysql://user:password@your-rds-host:3306/kimi_builders

# ---- 登录(OAuth)----
# GitHub OAuth App(建议挂在 kimi-builders org 下)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth Client(Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 会话签名密钥:openssl rand -base64 32
AUTH_SECRET=

# ---- AI 回帖(Moonshot 开放平台 API Key)----
KIMI_API_KEY=
# 模型,默认 kimi-k2.6(代码向任务可换 kimi-k2.7-code)
# KIMI_MODEL=kimi-k2.6

# ---- 用量同步 ----
# v1 全站共享密钥已停用。v2 将使用每用户、每设备凭证,
# 不要再添加会输出给客户端的全站同步密钥。
# 独立高熵 pepper,用于 HMAC 设备码和 kbu_ Key;不要复用或暴露到客户端。
USAGE_KEY_PEPPER=

# ---- 定时任务(Vercel Cron)----
# /api/cron/* 的 Bearer 校验密钥:openssl rand -base64 32
# Vercel 项目环境变量配置后,Cron 调用自动带 Authorization 头。
CRON_SECRET=

# ---- 对象存储(Cloudflare R2,图片上传)----
# endpoint 形如 https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kb-media
# 公开访问域名(R2 绑定的自定义域);本地开发未配时上传接口返回 503
R2_PUBLIC_BASE_URL=https://cdn.kimi.builders

# ---- 站点 ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
