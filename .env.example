# Environment template. Copy to .env.local and fill in what you need —
# most features degrade gracefully when their credentials are absent.
# Required for a fully working local instance: DATABASE_URL, AUTH_SECRET.

# ---- Database (self-hosted MySQL 8) ----
# The production database runs on the app host itself (see local ops docs);
# locally, create a dev database and run `npm run db:migrate` to build it.
# DATABASE_URL=mysql://root@127.0.0.1:3306/kb_dev
DATABASE_URL=mysql://user:password@127.0.0.1:3306/kb_dev
# Integration tests refuse to run unless the URL contains "kbu-mysql":
# DATABASE_URL=mysql://root@127.0.0.1:3306/kbu-mysql

# ---- Auth ----
# GitHub OAuth App — create at https://github.com/settings/developers
# (org-owned: https://github.com/organizations/kimi-builders/settings/applications)
# Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth Client — create at https://console.cloud.google.com/apis/credentials
# Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Session signing key (also signs the analytics visitor HMAC):
#   openssl rand -base64 32
AUTH_SECRET=

# ---- Transactional email (Resend) ----
# API key: https://resend.com/api-keys — sending domain mail.kimi.builders
# (https://resend.com/domains). Unset = soft-fail (server log only, no 500s).
RESEND_API_KEY=
# Optional sender override; default: kimi.builders <noreply@mail.kimi.builders>
# MAIL_FROM=

# ---- AI replies (Moonshot / Kimi) ----
# API key: https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=
# Optional model override; default kimi-k2.6 (kimi-k2.7-code for code tasks)
# KIMI_MODEL=kimi-k2.6

# ---- Usage sync ----
# The v1 site-wide shared secret is retired; v2 uses per-user, per-device
# credentials. Do not add any site-wide sync secret that ships to clients.
# High-entropy pepper for HMAC-ing device codes and kbu_ keys
# (openssl rand -base64 32). Never reuse it or expose it to clients.
USAGE_KEY_PEPPER=
# Optional: USAGE_OBSERVABILITY_VERBOSE=1 also logs successful ingest
# operations (failures and slow ops are always logged).
# USAGE_OBSERVABILITY_VERBOSE=

# ---- Cron routes ----
# Bearer secret for /api/cron/* — openssl rand -base64 32
# Production cron callers authenticate with this value. Deploys automatically
# install the deep-health caller; retention/retry schedules remain operator-managed.
CRON_SECRET=
# Optional HTTPS webhook for deep-health failure/recovery transitions.
# Receives JSON with service, check, status and text fields.
# HEALTH_ALERT_WEBHOOK_URL=

# ---- Object storage (Cloudflare R2, image uploads) ----
# API tokens: https://dash.cloudflare.com/profile/api-tokens (R2 Edit)
# Endpoint format: https://developers.cloudflare.com/r2/api/s3-api/ —
#   https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kb-media
# Public access domain (the R2 custom domain); uploads return 503 when
# storage is unconfigured — local dev works without it.
R2_PUBLIC_BASE_URL=https://cdn.kimi.builders

# ---- Site ----
# Canonical origin for OAuth redirect URIs and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
